<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="app.diagrams.net">
  <diagram name="SLEEC2Ver architecture" id="sleec2ver-architecture">
    <mxGraphModel dx="866" dy="556" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="parser" value="Marabou Parser" style="swimlane;html=1;rounded=1;arcSize=4;startSize=34;collapsible=0;fillColor=#CFDDF3;swimlaneFillColor=#EDF3FC;strokeColor=#4A72B0;strokeWidth=1.5;fontStyle=1;fontSize=17;fontColor=#1F3A66;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="230" y="10" width="626" height="212" as="geometry"/></mxCell>
        <mxCell id="read" value='&lt;div style="line-height:1.4"&gt;&lt;b&gt;② Read &amp;amp; normalize&lt;/b&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;parse spec (SLEEC grammar)&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;map measures → NN inputs,&lt;br&gt;output events → NN outputs&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;remove “unless” clauses&lt;br&gt;→ normalized rules&lt;/div&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#333333;rounded=1;absoluteArcSize=1;arcSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="parser"><mxGeometry x="16" y="50" width="280" height="146" as="geometry"/></mxCell>
        <mxCell id="gen" value='&lt;div style="line-height:1.4"&gt;&lt;b&gt;③ Generate queries&lt;/b&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;conditions → input bounds&lt;br&gt;and disjunctions&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;negate required output&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;one query per&lt;br&gt;normalized rule&lt;/div&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#333333;rounded=1;absoluteArcSize=1;arcSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="parser"><mxGeometry x="330" y="50" width="280" height="146" as="geometry"/></mxCell>
        <mxCell id="spec" value="① SLEEC&lt;br&gt;specification" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;strokeWidth=1.5;fillColor=#F2F2F2;strokeColor=#5F5F5F;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="10" y="83" width="178" height="66" as="geometry"/></mxCell>
        <mxCell id="verify" value='&lt;div style="line-height:1.4"&gt;&lt;b&gt;④ Marabou verification&lt;/b&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;solve each query → sat / unsat / timeout&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;combine into a verdict per original rule&lt;/div&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;strokeWidth=1.5;fillColor=#FFFFFF;strokeColor=#333333;rounded=1;absoluteArcSize=1;arcSize=16;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="353" y="294" width="380" height="86" as="geometry"/></mxCell>
        <mxCell id="nn" value="① Neural network" style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;strokeWidth=1.5;fillColor=#F2F2F2;strokeColor=#5F5F5F;shape=parallelogram;perimeter=parallelogramPerimeter;fixedSize=1;size=16;fontStyle=1;fontSize=16;" vertex="1" parent="1"><mxGeometry x="10" y="304" width="178" height="66" as="geometry"/></mxCell>
        <mxCell id="report" value='&lt;div style="line-height:1.4"&gt;&lt;b&gt;⑤ Report &amp;amp; illustration&lt;/b&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;verdict per rule&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;counterexample with named inputs/outputs&lt;/div&gt;&lt;div style="margin-left:13px;text-indent:-13px"&gt;•&amp;nbsp;scene picture (when the setup is known)&lt;/div&gt;&lt;/div&gt;' style="html=1;whiteSpace=wrap;fontFamily=Helvetica;fontColor=#1A1A1A;strokeWidth=1.5;fillColor=#E4F2E0;strokeColor=#5E9A4F;shape=document;size=0.131;boundedLbl=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=14;" vertex="1" parent="1"><mxGeometry x="353" y="424" width="380" height="122" as="geometry"/></mxCell>
        <mxCell id="queries" value="Marabou verification queries" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=14;fontStyle=2;fontColor=#1A1A1A;" vertex="1" parent="1"><mxGeometry x="553" y="247" width="240" height="22" as="geometry"/></mxCell>
