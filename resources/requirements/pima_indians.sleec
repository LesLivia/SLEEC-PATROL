def_start
    event cmdRequired

    // NN input 1: number of pregnancies
    measure pregnancies:scale(noPregnancies,lowPregnancies,mediumPregnancies,highPregnancies)
    constant pregnanciesLB = 0
    constant noPregnanciesLB = 0
    constant lowPregnanciesLB = 1
    constant mediumPregnanciesLB = 3
    constant highPregnanciesLB = 6
    constant pregnanciesUB = 17

    // NN input 2: plasma glucose concentration
    measure glucose:scale(lowGlucose,normalGlucose,impairedGlucose,highGlucose)
    constant glucoseLB = 0
    constant lowGlucoseLB = 0
    constant normalGlucoseLB = 70
    constant impairedGlucoseLB = 100
    constant highGlucoseLB = 126
    constant glucoseUB = 200

    // NN input 3: diastolic blood pressure
    measure bloodPressure:scale(lowBloodPressure,normalBloodPressure,preHighBloodPressure,highBloodPressure)
    constant bloodPressureLB = 0
    constant lowBloodPressureLB = 0
    constant normalBloodPressureLB = 60
    constant preHighBloodPressureLB = 80
    constant highBloodPressureLB = 90
    constant bloodPressureUB = 122

    // NN input 4: triceps skin fold thickness
    measure skinThickness:scale(lowSkinThickness,normalSkinThickness,highSkinThickness,veryHighSkinThickness)
    constant skinThicknessLB = 0
    constant lowSkinThicknessLB = 0
    constant normalSkinThicknessLB = 10
    constant highSkinThicknessLB = 30
    constant veryHighSkinThicknessLB = 50
    constant skinThicknessUB = 99

    // NN input 5: serum insulin
    measure insulin:scale(lowInsulin,normalInsulin,highInsulin,veryHighInsulin)
    constant insulinLB = 0
    constant lowInsulinLB = 0
    constant normalInsulinLB = 30
    constant highInsulinLB = 100
    constant veryHighInsulinLB = 200
    constant insulinUB = 846

    // NN input 6: body mass index
    measure bmi:scale(underweightBmi,normalBmi,overweightBmi,obeseBmi)
    constant bmiLB = 0
    constant underweightBmiLB = 0
    constant normalBmiLB = 18
    constant overweightBmiLB = 25
    constant obeseBmiLB = 30
    constant bmiUB = 67

    // NN input 7: diabetes pedigree function
    measure pedigree:scale(lowPedigree,mediumPedigree,highPedigree,veryHighPedigree)
    constant pedigreeLB = 0
    constant lowPedigreeLB = 0
    constant mediumPedigreeLB = 1
    constant highPedigreeLB = 3

    // NN input 8: age
    measure age:scale(youngAge,adultAge,seniorAge,elderlyAge)
    constant ageLB = 21
    constant youngAgeLB = 21
    constant adultAgeLB = 35
    constant seniorAgeLB = 50
    constant elderlyAgeLB = 65
    constant ageUB = 81

    // NN output: activation logits for these 4 commands
    event outputDiabetic
def_end

rule_start
    r1 when cmdRequired and ({glucose}>impairedGlucose) then outputDiabetic
rule_end