def_start
    event cmdRequired

    // NN input 1: baseline travel time for peripheral districts
    measure baselinePeripheralTravelTime:scale(lowBaselineTravelTime,mediumBaselineTravelTime,highBaselineTravelTime)
    constant baselinePeripheralTravelTimeLB = 5
    constant lowBaselineTravelTimeLB = 5
    constant mediumBaselineTravelTimeLB = 20
    constant highBaselineTravelTimeLB = 45
    constant baselinePeripheralTravelTimeUB = 60

    // NN input 2: candidate travel time for peripheral districts after optimization
    measure candidatePeripheralTravelTime:scale(lowCandidateTravelTime,mediumCandidateTravelTime,highCandidateTravelTime)
    constant candidatePeripheralTravelTimeLB = 5
    constant lowCandidateTravelTimeLB = 5
    constant mediumCandidateTravelTimeLB = 20
    constant highCandidateTravelTimeLB = 45
    constant candidatePeripheralTravelTimeUB = 75

    // NN input 3: congestion level in central districts
    measure centerCongestion:scale(lowCenterCongestion,mediumCenterCongestion,highCenterCongestion)
    constant centerCongestionLB = 0
    constant lowCenterCongestionLB = 0
    constant mediumCenterCongestionLB = 40
    constant highCenterCongestionLB = 75
    constant centerCongestionUB = 100

    // NN input 4: congestion level in peripheral districts
    measure peripheralCongestion:scale(lowPeripheralCongestion,mediumPeripheralCongestion,highPeripheralCongestion)
    constant peripheralCongestionLB = 0
    constant lowPeripheralCongestionLB = 0
    constant mediumPeripheralCongestionLB = 40
    constant highPeripheralCongestionLB = 75
    constant peripheralCongestionUB = 100

    // NN input 5: intensity of the proposed optimization
    measure optimizationIntensity:scale(noOptimization,lowOptimization,mediumOptimization,highOptimization)
    constant optimizationIntensityLB = 0
    constant noOptimizationLB = 0
    constant lowOptimizationLB = 10
    constant mediumOptimizationLB = 40
    constant highOptimizationLB = 75
    constant optimizationIntensityUB = 100

    // NN input 6: emergency mode
    measure emergencyMode:scale(noEmergency,highEmergency)
    constant noEmergencyLB = 0
    constant highEmergencyLB = 1

    // Operationalization threshold
    constant allowedIncreaseMinutes = 1

    // NN output: activation logits for these 2 decisions
    event outputDeployOptimization
    event outputBlockAndAlert
def_end

rule_start
    rs1 when cmdRequired and
        ({candidatePeripheralTravelTime} > {baselinePeripheralTravelTime})
        then not outputDeployOptimization
        unless ({emergencyMode} = highEmergencyLB)
rule_end