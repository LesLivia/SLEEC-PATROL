def_start
    event cmdRequired

    // ============================================================
    // COMPONENT: PPO actor for highway-fast-v0
    //
    // Environment (HighwayEnvFast.default_config):
    //   lanes_count = 3        -> lane centres at y = 0, 4, 8 (width 4 m)
    //   vehicles_count = 20    -> 20 IDM vehicles + 1 ego
    //   duration = 30 s, policy_frequency = 1 Hz -> 30 decisions per episode
    //
    // Observation (KinematicObservation, {"type": "Kinematics", "normalize": False}):
    //   vehicles_count = 5, features = [presence, x, y, vx, vy]
    //   -> 5 rows x 5 features = 25 inputs, row-major flattened.
    //   normalize = False   -> real units: metres, m/s.
    //   absolute  = False   -> rows 1..4 are ego-relative...
    //   ... but the EGO ROW IS ABSOLUTE: observe() builds it from
    //       observer_vehicle.to_dict() with no origin, and only the other
    //       rows get to_dict(origin=ego). So egoX/egoY/egoVx/egoVy carry
    //       absolute position and velocity, not zeros.
    //   see_behind = False  -> a vehicle is only observed if
    //       lane_distance_to > -2 * LENGTH, i.e. relative x > -10 m.
    //   PERCEPTION_DISTANCE = 5 * Vehicle.MAX_SPEED = 200 m.
    //   order = "sorted"    -> rows 1..4 are sorted by |longitudinal gap|,
    //       so row 1 is the NEAREST vehicle ahead in ANY lane, not the
    //       leader in ego's lane. Lane membership has to be read off y.
    //   Absent rows are ZERO-FILLED: presence = 0 and x = y = vx = vy = 0.
    //
    // Measure declaration order below fixes the Marabou input index (0-24).
    // The {name}LB / {name}UB constants are the verification box for each
    // input: the generator bounds every input of every query with them. A
    // boolean measure needs none, since its range is {0, 1} by default.
    //
    // BOUNDS PROVENANCE: highway-env's own feature ranges, from
    // KinematicObservation.normalize_obs (the defaults used when the config
    // supplies no "features_range"):
    //     x  : [-5 * Vehicle.MAX_SPEED, 5 * Vehicle.MAX_SPEED]      = [-200, 200]
    //     y  : [-DEFAULT_WIDTH * len(side_lanes), +same]            = [ -12,  12]   (3 lanes)
    //     vx : [-2 * Vehicle.MAX_SPEED, 2 * Vehicle.MAX_SPEED]      = [ -80,  80]
    //     vy : [-2 * Vehicle.MAX_SPEED, 2 * Vehicle.MAX_SPEED]      = [ -80,  80]
    //     presence: absent from features_range, never normalized, stays 0/1.
    // These are the ranges the library clips to when normalize = True, so
    // they are a superset of what the simulator produces -- with ONE
    // exception, noted on egoX below. The tighter physically reachable range
    // is given in a comment on each measure; narrowing to it makes the
    // Marabou queries smaller and rules out counterexamples the simulator
    // can never produce, at the cost of no longer matching the library.
    // ============================================================

    // --- Vehicle 0: Ego (index 0-4) ---
    // the ego row is always present: its flag is fixed at 1 by the
    // 'measure invariant' in the relation block
    measure egoPresence: boolean

    // EXCEPTION to the provenance note above: this row is absolute, and with
    // normalize = False nothing clips it, so egoX runs far past the library's
    // +-200 range. The library only gets away with +-200 because
    // normalize = True clips it there; here +-200 would be unsound and would
    // restrict every query to the first two seconds of an episode.
    //
    // Spawn: the ego is created before any other vehicle, so road.vehicles is
    // empty and create_random puts it at x0 = 3*offset + offset*U(0.9, 1.1),
    // with offset = ego_spacing * (12 + speed) * exp(-5/40 * lanes)
    //             = 1.5 * (12 + 25) * exp(-0.375) = 38.1  ->  x0 in [149, 156].
    // Travel: duration 30 s at policy_frequency 1 Hz = 30 steps at <= 30 m/s,
    // so at most 900 m further  ->  egoX <= about 1056.
    //
    // Note this input carries no decision-relevant information, yet it is an
    // order of magnitude larger than every other feature. Expect it to show up
    // in counterexamples; the fix is a wrapper that zeroes it, not a weaker rule.
    measure egoX: numeric
    constant egoXLB = 140
    constant egoXUB = 1100

    // library range; reachable is [-2, 10] (3 lanes -> centres 0 / 4 / 8)
    measure egoY: numeric
    constant egoYLB = -12
    constant egoYUB = 12

    // library range; reachable is [15, 32] (MDPVehicle tracks {20, 25, 30},
    // created at 25.0, and the episode terminates on collision)
    measure egoVx: numeric
    constant egoVxLB = -80
    constant egoVxUB = 80

    // library range; reachable is [-5, 5] (non-zero only during a lane change)
    measure egoVy: numeric
    constant egoVyLB = -80
    constant egoVyUB = 80

    // --- Vehicle 1 (index 5-9) ---
    // presence flag: 1 = observed, 0 = absent (row zero-filled)
    measure v1Presence: boolean

    // relative: > 0 ahead of ego. Library range; reachable is (-10, 200],
    // since see_behind = False drops anything with lane_distance_to <= -10
    // and PERCEPTION_DISTANCE = 200 bounds the far side.
    measure v1X: numeric
    constant v1XLB = -200
    constant v1XUB = 200

    // library range; reachable is [-10, 10] (one lane offset = 4 m,
    // 3 lanes -> at most 2 lanes away)
    measure v1Y: numeric
    constant v1YLB = -12
    constant v1YUB = 12

    // relative: v1Vx < 0 means v1 is slower than ego (ego is closing in).
    // Library range; reachable is about [-30, 20].
    measure v1Vx: numeric
    constant v1VxLB = -80
    constant v1VxUB = 80

    // library range; reachable is about [-10, 10]
    measure v1Vy: numeric
    constant v1VyLB = -80
    constant v1VyUB = 80

    // --- Vehicle 2 (index 10-14) ---
    measure v2Presence: boolean

    measure v2X: numeric
    constant v2XLB = -200
    constant v2XUB = 200

    measure v2Y: numeric
    constant v2YLB = -12
    constant v2YUB = 12

    measure v2Vx: numeric
    constant v2VxLB = -80
    constant v2VxUB = 80

    measure v2Vy: numeric
    constant v2VyLB = -80
    constant v2VyUB = 80

    // --- Vehicle 3 (index 15-19) ---
    measure v3Presence: boolean

    measure v3X: numeric
    constant v3XLB = -200
    constant v3XUB = 200

    measure v3Y: numeric
    constant v3YLB = -12
    constant v3YUB = 12

    measure v3Vx: numeric
    constant v3VxLB = -80
    constant v3VxUB = 80

    measure v3Vy: numeric
    constant v3VyLB = -80
    constant v3VyUB = 80

    // --- Vehicle 4 (index 20-24) ---
    measure v4Presence: boolean

    measure v4X: numeric
    constant v4XLB = -200
    constant v4XUB = 200

    measure v4Y: numeric
    constant v4YLB = -12
    constant v4YUB = 12

    measure v4Vx: numeric
    constant v4VxLB = -80
    constant v4VxUB = 80

    measure v4Vy: numeric
    constant v4VyLB = -80
    constant v4VyUB = 80

    // ============================================================
    // SEMANTIC THRESHOLDS, in metres and m/s. A rule names the constant and
    // the generator reads its value. Values are integers: the grammar's
    // Value rule is INT only.
    // ============================================================

    // "in ego's lane": |dy| < 2, i.e. inside the 4 m lane
    constant inLaneLo = -2
    constant inLaneHi = 2

    // "ahead of ego": past the front bumper, and within braking range
    constant justAhead = 0
    constant closeAhead = 30

    // "too close to stop in time": < 10 m. At 30 m/s that is a third of a
    // second, and SLOWER only steps the target speed down by 5 m/s.
    constant dangerClose = 10

    // "ego is closing in": relative vx < -5 m/s (v1Vx = v1 speed - ego speed)
    constant closing = -5

    // "a lane exists to the right": 3 lanes -> centres 0 / 4 / 8, so the
    // rightmost lane is y = 8 and anything below 6 has room to its right.
    constant rightLaneExists = 6

    // ============================================================
    // NN OUTPUTS: PPO action logits (argmax = selected action).
    // Declaration order must match highway-env DiscreteMetaAction:
    //   0 = LANE_LEFT  1 = IDLE  2 = LANE_RIGHT  3 = FASTER  4 = SLOWER
    // FASTER / SLOWER step the target speed within {20, 25, 30} m/s;
    // there is no stop action, and no steering action.
    // ============================================================
    event outputLaneLeft
    event outputIdle
    event outputLaneRight
    event outputFaster
    event outputSlower

def_end

rule_start
    // ============================================================
    // AutoCar R8 -- "When an obstacle appears ahead, stop until it clears;
    //                if stopping is unsafe, change lanes."
    //
    //   obstacle ahead   -> v1 present, inside ego's lane band, 0..30 m
    //                       ahead, and ego closing in on it. All five rows
    //                       are vehicles; a stationary obstacle and a much
    //                       slower car are the same observation. Only row 1
    //                       is checked: it is the nearest vehicle, but in any
    //                       lane, so an obstacle in row 2..4 is not covered.
    //   stop             -> outputSlower. There is no stop action: SLOWER
    //                       steps the target speed down within {20, 25, 30}.
    //   until it clears  -> no temporal operator needed. A state-based rule
    //                       constrains EVERY state in which the obstacle is
    //                       present, and stops applying once it is not.
    //   stopping unsafe  -> the obstacle is too close to stop in time
    //                       (riskLevel has no input feature)...
    //   change lanes     -> ...and a lane change is possible: a right-hand
    //                       lane exists and no other vehicle is perceived, so
    //                       that lane is clear by construction. Then
    //                       outputLaneRight. When the lane change is not
    //                       possible, the main case still demands braking.
    //
    // The generator splits the rule into two queries with disjoint inputs:
    //   r8_main     obstacle and not (unsafe and lane free)  -> outputSlower
    //   r8_unless1  obstacle and unsafe and lane free        -> outputLaneRight
    // ============================================================
    r8 when cmdRequired and
        ({v1Presence} and
         ((({v1Y} > inLaneLo) and ({v1Y} < inLaneHi)) and
          ((({v1X} > justAhead) and ({v1X} < closeAhead)) and ({v1Vx} < closing))))
        then outputSlower
        unless (({v1X} < dangerClose) and
                (({egoY} < rightLaneExists) and
                 ((not {v2Presence}) and ((not {v3Presence}) and (not {v4Presence})))))
        then outputLaneRight
rule_end

relation_start
    // ============================================================
    // DATASET CONSTRAINTS: facts that hold for every observation
    // highway-env produces (KinematicObservation.observe):
    //   - the ego row is always present (built from the ego vehicle itself);
    //   - an absent vehicle's row is zero-filled: presence = 0 and
    //     x = y = vx = vy = 0.
    // ============================================================
    measure invariant {egoPresence}
    measure imply (not {v1Presence}) (((({v1X} = 0) and ({v1Y} = 0)) and ({v1Vx} = 0)) and ({v1Vy} = 0))
    measure imply (not {v2Presence}) (((({v2X} = 0) and ({v2Y} = 0)) and ({v2Vx} = 0)) and ({v2Vy} = 0))
    measure imply (not {v3Presence}) (((({v3X} = 0) and ({v3Y} = 0)) and ({v3Vx} = 0)) and ({v3Vy} = 0))
    measure imply (not {v4Presence}) (((({v4X} = 0) and ({v4Y} = 0)) and ({v4Vx} = 0)) and ({v4Vy} = 0))
relation_end
